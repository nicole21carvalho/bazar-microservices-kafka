# Copie para .env e preencha. O .env esta no .gitignore de proposito:
# senha commitada e senha vazada.
#
# Uma senha por servico: se a de um vazar, os bancos dos outros continuam
# protegidos. Gere cada uma com: openssl rand -hex 24
# O Postgres so aplica as senhas na primeira subida, quando cria o volume.

DB_SENHA_ADMIN=
DB_SENHA_PEDIDOS=
DB_SENHA_ESTOQUE=
DB_SENHA_PAGAMENTOS=
DB_SENHA_NOTIFICACOES=
DB_SENHA_KEYCLOAK=

# Administrador do Keycloak (http://localhost:8180/admin). So para configurar
# o Keycloak: os clientes da loja se cadastram pela tela de login.
KC_SENHA_ADMIN=
