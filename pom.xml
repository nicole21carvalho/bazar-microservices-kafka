<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>br.com.nicole.bazar</groupId>
    <artifactId>bazar</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>
    <name>bazar</name>
    <description>Loja online em microsservicos que conversam por eventos no Kafka</description>

    <!-- Um repositorio, varios servicos: cada modulo gera a sua imagem e
         sobe sozinho. O "comum" e uma biblioteca, nao um servico. -->
    <modules>
        <module>comum</module>
        <module>pedidos</module>
        <module>estoque</module>
        <module>pagamentos</module>
        <module>notificacoes</module>
        <module>gateway</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <spring-cloud.version>2025.1.3</spring-cloud.version>

        <!-- Correcoes de seguranca a frente do Boot 4.1.1, que traz versoes com
             CVE: Tomcat 11.0.24 (tres criticas, ate 9.8) e Jackson 3.1.5 (varias
             altas). Sao so versoes de patch da mesma linha. Remover quando o
             Boot passar a trazer estas ou mais novas; o osv-scanner do CI avisa
             se alguma voltar a ter falha conhecida. -->
        <tomcat.version>11.0.26</tomcat.version>
        <jackson-bom.version>3.1.7</jackson-bom.version>
        <jackson-2-bom.version>2.21.7</jackson-2-bom.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Vem pelo cliente do Kafka. A 1.10.1 tem a CVE-2026-59949 (JVM
                 pode cair com argumentos invalidos no XXHash nativo); a
                 correcao saiu na 1.11.1. Remover quando o kafka-clients trouxer
                 uma versao corrigida. -->
            <dependency>
                <groupId>at.yawk.lz4</groupId>
                <artifactId>lz4-java</artifactId>
                <version>1.12.0</version>
            </dependency>
            <dependency>
                <groupId>br.com.nicole.bazar</groupId>
                <artifactId>comum</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.nicole.bazar</groupId>
                <artifactId>comum</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
